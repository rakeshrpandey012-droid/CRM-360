{
  "name": "crm360-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "CRM360 - SaaS Customer Relationship Management Platform (MERN Stack)",
  "scripts": {
    "build": "npm run build --prefix client",
    "start": "node server/server.js",
