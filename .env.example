# CRM360 Environment Variables for Vercel & Production Deployments
# For Fullstack Vercel deployment: configure these in your Vercel Project Settings -> Environment Variables

# MongoDB Atlas Database Connection String (Required for persistent production DB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/crm360?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random strings)
JWT_SECRET=crm360_production_jwt_super_secret_key_2026
JWT_REFRESH_SECRET=crm360_production_jwt_refresh_super_secret_key_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Environment Mode
NODE_ENV=production

# (Optional - only required if frontend is deployed separately from backend)
# VITE_API_URL=https://crm360-api.yourdomain.com
